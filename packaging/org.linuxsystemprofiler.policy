<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Linux System Profiler — PolicyKit actions (v0.6).

  Installing this file to /usr/share/polkit-1/actions/ turns the generic,
  intimidating system authentication prompt ("Authentication is needed to
  run /usr/bin/pacman as the super user") into a branded, plain-language
  one that names the app and explains why admin rights are needed — the
  difference between a beginner trusting the prompt and cancelling it.

  Install (packaging step, requires root once):
    sudo install -m 644 org.linuxsystemprofiler.policy /usr/share/polkit-1/actions/
-->
<policyconfig>
  <vendor>Linux System Profiler</vendor>
  <icon_name>linux-system-profiler</icon_name>

  <action id="org.linuxsystemprofiler.dmidecode">
    <description>Read memory module and system details</description>
    <message>Linux System Profiler needs administrator rights to read your memory module details (sizes, speeds, and serial numbers) from the hardware.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/dmidecode</annotate>
  </action>

  <action id="org.linuxsystemprofiler.pacman">
    <description>Install system package updates</description>
    <message>Linux System Profiler needs administrator rights to install system package updates with pacman.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/pacman</annotate>
  </action>

  <action id="org.linuxsystemprofiler.apt">
    <description>Install system package updates</description>
    <message>Linux System Profiler needs administrator rights to install system package updates with APT.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/apt-get</annotate>
  </action>

  <action id="org.linuxsystemprofiler.dnf">
    <description>Install system package updates</description>
    <message>Linux System Profiler needs administrator rights to install system package updates with DNF.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/dnf</annotate>
  </action>

  <action id="org.linuxsystemprofiler.fwupd">
    <description>Install firmware updates</description>
    <message>Linux System Profiler needs administrator rights to install firmware updates. Do not turn off the computer while firmware is updating.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/fwupdmgr</annotate>
  </action>
</policyconfig>
